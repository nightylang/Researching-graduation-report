@using System.Data
@model DataTable
@{
    ViewData["Title"] = "System Administration Panel";
}

<div class="container-fluid mt-4">
    <div class="row">
        <!-- Left Column: Create New Employee Form -->
        <div class="col-lg-4 col-md-5 col-sm-12 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0">Initialize Employee CRUD Profile</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Employee" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Given/First Name</label>
                            <input type="text" class="form-control" name="firstName" required placeholder="John" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Family/Last Name</label>
                            <input type="text" class="form-control" name="lastName" required placeholder="Doe" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Corporate Email Gateway</label>
                            <input type="email" class="form-control" name="email" required placeholder="j.doe@enterprise.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Structural Role Designation</label>
                            <select class="form-select" name="role">
                                <option value="Employee">Standard Employee</option>
                                <option value="Manager">Department Manager</option>
                                <option value="Administrator">System Admin</option>
                            </select>
                        </div>
                        
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success rounded-pill shadow-sm">Commit Record to Database</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Active Identities Registry Table -->
        <div class="col-lg-8 col-md-7 col-sm-12">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Relational Database Identity Clusters</h5>
                    <span class="badge bg-light text-dark">Active System Records: @Model.Rows.Count</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">ID Tokens</th>
                                    <th>Full Identity Identity</th>
                                    <th>Email Destination</th>
                                    <th>Role Classification</th>
                                    <th>State Switch</th>
                                    <th class="text-center pe-3">Purge Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Rows.Count > 0)
                                {
                                    @foreach (DataRow row in Model.Rows)
                                    {
                                        <tr>
                                            <td class="ps-3 font-monospace fw-bold text-muted">#@row["EmployeeID"]</td>
                                            <td>@row["LastName"], @row["FirstName"]</td>
                                            <td>@row["Email"]</td>
                                            <td><span class="badge bg-secondary">@row["Role"]</span></td>
                                            <td>
                                                <form asp-controller="Employee" asp-action="UpdateStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="employeeId" value="@row["EmployeeID"]" />
                                                    <input type="hidden" name="isActive" value="@((bool)row["IsActive"] ? "false" : "true")" />
                                                    <button type="submit" class="btn btn-sm @((bool)row["IsActive"] ? "btn-outline-success" : "btn-outline-warning") rounded-pill py-0 px-2">
                                                        @((bool)row["IsActive"] ? "● Active" : "○ Suspended")
                                                    </button>
                                                </form>
                                            </td>
                                            <td class="text-center pe-3">
                                                <form asp-controller="Employee" asp-action="Delete" method="post" onsubmit="return confirm('Execute permanent database purge?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="employeeId" value="@row["EmployeeID"]" />
                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 border-0">Purge</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted">No operational data structures committed to this cluster layer yet.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
